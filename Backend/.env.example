# Environment Variables for AI Sustainability Discovery Backend

# Server Config
PORT=8000
HOST=0.0.0.0

# Database
DATABASE_URL=sqlite:///./sustainability.db

# AI Provider Configurations
# Note: Keep keys private on the backend. NEVER expose to frontend.

# Google Gemini API Configuration (Recommended)
GEMINI_API_KEY=your_gemini_api_key_here

# IBM watsonx.ai Configuration (Optional)
WATSONX_API_KEY=your_ibm_watsonx_api_key_here
WATSONX_PROJECT_ID=your_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
